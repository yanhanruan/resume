# LaTeX-specific ignores
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz

# Build output
build/

# IDE-specific ignores (VSCode, TeXstudio, etc.)
.vscode/
*.vscode/
*.vscode-workspace
*.tps

# Edit accordingly for other LaTeX editors
.texstudio/
.texstudio.ini

# Temporary files
*.swp
*~

# Compiled PDFs (may contain personal data) — keep them local, do not commit
*.pdf
dist/

# Private real résumé content — overrides the committed generic templates
# via \resumeInput in style/resume.cls. Kept local, never committed.
private/

#miscellany
miscellany/
