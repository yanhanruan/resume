# LaTeX-specific ignores
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz

# Build output
build/

# IDE-specific ignores (VSCode, TeXstudio, etc.)
.vscode/
*.vscode/
*.vscode-workspace
*.tps

# Edit accordingly for other LaTeX editors
.texstudio/
.texstudio.ini

# Temporary files
*.swp
*~

# Compiled PDFs (may contain personal data) — keep them local, do not commit
*.pdf
dist/

# Private real résumé content — overrides the committed generic templates
# via \resumeInput in style/resume.cls. Kept local, never committed.
private/

# Company-tailored application versions stay local. Only the two public
# template wrappers below are tracked; any other versions/*_resume.tex
# (e.g. one tailored to a specific employer) is ignored by default.
versions/*_resume.tex
!versions/base_resume.tex
!versions/alt_resume.tex

#miscellany
miscellany/
